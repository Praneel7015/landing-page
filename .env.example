# Umami Analytics (existing dashboard, new website ID for praneel.sindhole.com)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=

# Cloudflare Web Analytics (manual setup beacon token)
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# giscus comments (from https://giscus.app/)
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Contact form (existing) — AWS Lambda Function URL
NEXT_PUBLIC_CONTACT_LAMBDA_URL=

# Chatbot endpoint (existing)
NEXT_PUBLIC_CHATBOT_ENDPOINT=

# Protected WhatsApp button on /contact (pages/api/contact-link.js)
# Cloudflare Turnstile site key (public) and secret (server only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Server only: click-to-chat link, https://wa.me/91XXXXXXXXXX (optionally ?text=...),
# or a WhatsApp Business short link. Never prefix it with NEXT_PUBLIC_.
CONTACT_WHATSAPP_URL=
# Comma-separated ISO country codes allowed to get the links (default IN).
# Production geo checks require Vercel and its "Automatically expose System
# Environment Variables" project setting; non-Vercel production fails closed.
CONTACT_ALLOWED_COUNTRIES=IN
